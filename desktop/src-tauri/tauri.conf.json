{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inventix",
  "version": "0.1.0",
  "identifier": "com.example.inventix",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run serve"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inventix",
        "width": 1200,
        "height": 800,
        "minWidth": 720,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080 http://localhost:* http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
